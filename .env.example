# ── Translation providers (chỉ cần điền cái nào bạn dùng, fallback tự động) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GOOGLE_API_KEY_2=

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# ── ASR ──
DEFAULT_SOURCE_LANG=en-US
AUDIO_SAMPLE_RATE=16000

# ── Output ──
OUTPUT_DIR=./output

# ── Offline translation (NLLB, dùng khi translate_mode=offline hoặc fallback) ──
# distilled-600M (nhanh nhẹ) | distilled-1.3B (mặc định) | 1.3B | 3.3B (nặng, chất lượng cao nhất)
NLLB_MODEL_NAME=facebook/nllb-200-distilled-1.3B

# ── VieNeu TTS ──
VIENEU_MODE=v3turbo
VIENEU_VOICE_MALE=manhdung_ref
VIENEU_VOICE_FEMALE=ngochuyen_ref
VIENEU_FIT_TIMING=0
# format: key1:male:voices/male1.wav,key2:female:voices/female1.wav
VIENEU_CUSTOM_VOICES=

# ── Audio timing (1.0 = giữ nguyên tốc độ) ──
AUDIO_SLOW_FACTOR=1.0
